{
	"name": "@sowapps/so-core",
	"description": "SoCore is a Symfony Bundle to bring basic features to your Sowapps App",
	"license": "MIT",
	"version": "0.1.0",
	"symfony": {
		"controllers": {
			"admin-auth-main": {
				"main": "controllers/admin-auth/main_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"admin-auth-login": {
				"main": "controllers/admin-auth/login_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"admin-main": {
				"main": "controllers/admin/main_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"admin-log-view": {
				"main": "controllers/admin/log-view_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"admin-user-edit": {
				"main": "controllers/admin/user-edit_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"admin-user-list": {
				"main": "controllers/admin/user-list_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"confirm": {
				"main": "controllers/component/confirm_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"confirm-dialog": {
				"main": "controllers/component/confirm-dialog_controller.js",
				"fetch": "eager",
				"enabled": true
			},
			"dialog": {
				"main": "controllers/component/dialog_controller.js",
				"fetch": "eager",
				"enabled": true
			}
		},
		"importmap": {
			"@hotwired/stimulus": "^3.0.0",
			"bootstrap": "^5.3.0",
			"@popperjs/core": "^2.0.0",
			"dayjs": "^1.0.0"
		}
	},
	"peerDependencies": {
		"@hotwired/stimulus": "^3.0.0",
		"bootstrap": "^5.3.0",
		"@popperjs/core": "^2.0.0",
		"dayjs": "^1.0.0"
	}
}
