{# @var string cardClass #}
<div class="card mb-3 {{ cardClass | default() }}">
	{% if header is defined %}
		<div class="card-header">
			{{ header }}
		</div>
	{% endif %}
	<div class="card-body">
		{% block body %}
			{% if bodyTitle is defined %}
				<h5 class="card-title">{{ bodyTitle }}</h5>
			{% endif %}
			{% block bodyContent %}{% endblock %}
		{% endblock %}
	</div>
	{% if block('footer') is defined %}
		<div class="card-footer text-right text-end">
			{{ block('footer') }}
		</div>
	{% endif %}
</div>
