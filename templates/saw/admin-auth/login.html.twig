<template data-template-wrapper="layout-public.html" data-param--page="{{ 'page.admin-login.label' | trans }}">
	<div class="bg-light h-100" data-controller="sowapps--so-core--admin-auth-login">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-5">
					<form data-sowapps--so-core--admin-auth-login-target="form" data-action="sowapps--so-core--admin-auth-login#submitAuthentication">
						<div class="card shadow-lg border-0 rounded-lg mt-5">
							<div class="card-header border-5 border-primary">
								<h3 class="font-weight-light my-4 text-center text-primary text-uppercase">
									Log in
								</h3>
							</div>
							<div class="card-body pt-5 px-5">
								<div class="alert alert-danger" role="alert" data-sowapps--so-core--admin-auth-login-target="error" hidden></div>
								<div class="form-floating mb-3">
									<input class="form-control" id="InputLoginEmail" type="email" name="username">
									<label for="InputLoginEmail">Email address</label>
								</div>
								<div class="form-floating mb-3">
									<input class="form-control" id="InputLoginPassword" type="password" name="password">
									<label for="InputLoginPassword">Password</label>
								</div>
								<div class="d-grid gap-2 py-3">
									<button class="btn btn-primary btn-lg mx-5 text-uppercase" type="submit" name="submitLogin">Log in</button>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</template>
